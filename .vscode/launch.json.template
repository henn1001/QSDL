{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QSDL - Pet Store (Spring)",
      "type": "debugpy",
      "request": "launch",
      "module": "qsdl",
      "args": [
        "generate",
        "spring",
        "-i",
        "examples/00-pet-store/domain/pet-store.qsdl",
        "-o",
        "xtmp/pet-store"
      ],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "QSDL - Pet Store (OpenAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "qsdl",
      "args": [
        "generate",
        "openapi",
        "-i",
        "examples/00-pet-store/domain/pet-store.qsdl",
        "-o",
        "xtmp/pet-store-openapi"
      ],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "QSDL - Pet Store (PlantUML)",
      "type": "debugpy",
      "request": "launch",
      "module": "qsdl",
      "args": [
        "generate",
        "plantuml",
        "-i",
        "examples/00-pet-store/domain/pet-store.qsdl",
        "-o",
        "xtmp/pet-store-plantuml"
      ],
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
