{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "generate spring",
      "type": "shell",
      "group": "build",
      "command": "qsdl generate spring -i examples/00-pet-store/domain/pet-store.qsdl -o examples/00-pet-store -S title=PetStore -S group_id=app -S artifact_id=pet-store"
    },
    {
      "label": "spring smoke",
      "type": "shell",
      "command": "python examples/run-spring-smoke.py",
      "group": "test"
    }
  ]
}