/*
  DSL grammar.
*/

Schema:
    imports*=Import
    ('title' ':' title=STRING)?
    ('version' ':' version=STRING)?
    ('description' ':' description=Description)?
    ('servers' ':' '[' servers+=STRING[','] ']')?
    types*=Type
;

Type:
    Scalar | Enum | Base | Api | Object
;

ValueType:
    Scalar | Enum | Base | Object
;

Import:
    'import' importURI=STRING
;

Scalar:
    'scalar' name=ID

    directives*=Directive
;

Enum:
    description=Description?
    'enum' name=ID

    directives*=Directive

    '{'
        values+=ID
    '}'
;

Base:
    description=Description?

    'base' name=ID

    ('extends' supertypes+=[Base][','])?

    directives*=Directive

    '{'
        fields*=Field
    '}'
;

Object:
    description=Description?

    'type' name=ID

    ('extends' supertypes+=[Base][','])?

    directives*=Directive

    '{'
        fields*=Field
        api=Api?
    '}'
;

Field:
    description=Description?

    // LHS
    name=ID

    // Delimiter
    ':'

    // RHS
    (is_array?='[' &/.*\]/)?
    value=[ValueType]
    (']')?
    (is_required?='!')?

    directives*=Directive
;

Api :
    description=Description?

    'extend' 'api'

    directives*=Directive

    '{'
        operations*=Operation
    '}'
;

Operation:
    description=Description?

    // LHS
    name=ID
    ('(' &/.*\)/)?
    (arguments+=Argument[','])?
    ')'?

    // Delimiter
    ':'

    // RHS
    (is_array?='[' &/.*\]/)?
    value=[ValueType]
    (']')?
    (is_required?='!')?

    directives*=Directive
;

Argument:
    // LHS
    name=ID

    // Delimiter
    ':'

    // RHS
    (is_array?='[' &/.*\]/)?
    value=[ValueType]
    (']')?

    // Argument location and requiredness modifiers
    (
        (is_required?='!')?
        (is_query?='?')?
        (is_header?='^')?
    )#
;

Directive:
    '@'
    name=ID
    // Owners bind these captures after reference resolution.
    (&'(' has_parens?='(' value=DirectiveValue? ')')?
;

Description:
    SingleLine | MultiLine
;

SingleLine:
    /\"([^\"\n\r]+?)\"/
;

MultiLine:
    /(?ms)\"{3}(.+?)\"{3}/
;

Comment:
    /\/\/.*$/
;

ID:
    /[^\d\W][\w-]*/
;

DirectiveValue:
    /(?:"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|[^()"'])+/
;
