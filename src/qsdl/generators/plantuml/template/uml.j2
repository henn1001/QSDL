#  Enums
```plantuml
@startuml

{% for enum in xtx.get_children_of_type("Enum", schema) %}
enum {{enum.name}} {
    {% for value in enum.values %}
    {{value}}
    {% endfor %}
}

{% endfor %}

@enduml
```


# Bases
```plantuml
@startuml

{% for base in xtx.get_children_of_type("Base", schema) %}
abstract class {{base.name}}{% if base.supertypes %} <extends {% for st in base.supertypes %}{{st.name}}{{", " if not loop.last}}{% endfor %}>{% endif %} {
    {% for field in diagram_fields(base) %}
    {{field.name}}: {{"[" if field.is_array}}{{field.value.name}}{{"]" if field.is_array}}
    {% endfor %}
}

{% endfor %}

@enduml
```


# Model Overview
```plantuml
@startuml

{% for object in xtx.get_children_of_type("Object", schema) %}
{% if object.directive.namespace and object.directive.namespace.value %}
namespace {{object.directive.namespace.value}} #DDDDDD {
{% endif %}
class {{object.name}} {% if object.supertypes %}<implements {% for st in object.supertypes %}{{st.name}}{{", " if not loop.last}}{% endfor %}>{% endif %} {
    {% for field in diagram_fields(object) if not field.directive.is_composition and not field.directive.is_aggregation %}
    {{field.name}}: {{"[" if field.is_array}}{{field.value.name}}{{"]" if field.is_array}}
    {% endfor %}

    {% for operation in object.api.operations %}
    {method} {{operation.directive.method.value | upper}} {{operation.name}}()
    {% endfor %}
}
{% if object.directive.namespace and object.directive.namespace.value %}
}
{% endif %}

{% endfor %}

{% for obj in xtx.get_children_of_type("Object", schema) %}
  {% for field in get_aggregation(schema, obj) %}
{{field.parent.directive.namespace.value + "." if field.parent.directive.namespace and field.parent.directive.namespace.value}}{{field.parent.name}} --o {{obj.directive.namespace.value + "." if obj.directive.namespace and obj.directive.namespace.value}}{{obj.name}}
  {% endfor %}
  {% for field in get_compositions(schema, obj) %}
{{field.parent.directive.namespace.value + "." if field.parent.directive.namespace and field.parent.directive.namespace.value}}{{field.parent.name}} --* {{obj.directive.namespace.value + "." if obj.directive.namespace and obj.directive.namespace.value}}{{obj.name}}
  {% endfor %}
{% endfor %}


@enduml
```
