# Optional local overrides:
spring.config.import: optional:file:./application-properties.yaml

### Core
server.port: 8080
spring.jpa.open-in-view: false
spring.threads.virtual.enabled: true
{% if use_auditing %}
### Audits
spring.jpa.properties.org.hibernate.envers.audit_strategy: ValidityAuditStrategy
{% endif %}

### Monitoring service
management.server.port: 8081
management.endpoints.web.base-path: /actuator
management.endpoint.health.show-details: never
management.endpoints.web.exposure.include: health,info,metrics,loggers

### Logging
logging.pattern.console: "%clr(%d{HH:mm:ss.SSS}){faint} %highlight(%-5level) %clr(%logger{0}){cyan} %clr(-){faint} %msg %kvp%n"
logging.pattern.file: "%d{yyyy-MM-dd HH:mm:ss.SSS XXX} %-5level [%thread] %logger - %msg %kvp%n"

# Optionally, enable structured logging in ECS format for console or file output.
# logging.file.name: logs/app.log
# logging.structured.format.console: ecs
# logging.structured.format.file: ecs

# Springdoc
# Disable Springdoc's generated OpenAPI endpoints.
springdoc.api-docs.enabled: false

# Serve Swagger UI using the application-provided OpenAPI document.
springdoc.swagger-ui.enabled: true
springdoc.swagger-ui.path: /api/swagger-ui
springdoc.swagger-ui.url: /api/docs/openapi.json
springdoc.swagger-ui.disable-swagger-default-url: true

# Profile
spring.profiles.default: h2

---
################################################################################
spring.config.activate.on-profile: h2

### Datasource
spring.jpa.hibernate.ddl-auto: update

spring.datasource.url: jdbc:h2:mem:testdb;MODE=PostgreSQL
spring.datasource.username: h2
spring.datasource.password: h2

### Flyway
spring.flyway.enabled: false

---
################################################################################
spring.config.activate.on-profile: postgres

### Datasource
spring.jpa.hibernate.ddl-auto: validate

spring.datasource.url: jdbc:postgresql://localhost:5432/postgres?currentSchema=spring
spring.datasource.username: postgres
spring.datasource.password: postgres

### Flyway
spring.flyway.enabled: true
spring.flyway.schemas: spring
spring.flyway.locations: classpath:db/migration
spring.flyway.out-of-order: true
spring.flyway.ignoreMigrationPatterns: "*:missing"
