package {{package.config}};

{{ util.macro_imports(self._TemplateReference__context.name) }}

@Configuration
@EnableScheduling
{% if database == "HIBERNATE" %}
@EnableJpaRepositories(
        basePackages = "{{base_package}}",
        repositoryBaseClass = BaseRepositoryImpl.class)
