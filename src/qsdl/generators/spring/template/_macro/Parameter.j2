{%- macro paramsApi(operation) -%}

    {%- for parameter in operation.path_parameters -%}
        @PathVariable("{{parameter.source.name}}") {{ param_helper(parameter) }}
        {%- if not loop.last or operation.filter_name or operation.source.directive.is_pageable or operation.request_dto_name or operation.body_parameters -%}{{", "}}{% endif -%}
    {%- endfor %}

    {%- if operation.filter_name -%}
            @Valid {{operation.filter_name}} filter
        {%- if operation.source.directive.is_pageable or operation.request_dto_name or operation.body_parameters -%}{{", "}}{% endif -%}
    {%- endif -%}

    {%- if operation.source.directive.is_pageable -%}
            CursorPageable pageable
        {%- if operation.request_dto_name or operation.body_parameters -%}{{", "}}{% endif -%}
    {%- endif -%}

    {%- if operation.request_dto_name -%}
            @Valid @RequestBody {{operation.request_dto_name}} request
    {%- elif operation.body_parameters and operation.method == "patch" -%}
            @RequestBody JsonMergePatch patch
    {%- elif operation.body_parameters -%}
            {% if operation.body_parameters[0].is_model and not operation.body_parameters[0].source.is_array %}@Valid {% endif %}@RequestBody {{ param_helper(operation.body_parameters[0], true) }}
    {%- endif -%}

{%- endmacro %}

{%- macro paramsController(operation) -%}

    {%- for parameter in operation.path_parameters -%}
        {{ param_helper(parameter) }}
        {%- if not loop.last or operation.filter_name or operation.source.directive.is_pageable or operation.request_dto_name or operation.body_parameters -%}{{", "}}{% endif -%}
    {%- endfor %}

    {%- if operation.filter_name -%}
            {{operation.filter_name}} filter
        {%- if operation.source.directive.is_pageable or operation.request_dto_name or operation.body_parameters -%}{{", "}}{% endif -%}
    {%- endif -%}

    {%- if operation.source.directive.is_pageable -%}
            CursorPageable pageable
        {%- if operation.request_dto_name or operation.body_parameters -%}{{", "}}{% endif -%}
    {%- endif -%}

    {%- if operation.request_dto_name -%}
            {{operation.request_dto_name}} request
    {%- elif operation.body_parameters and operation.method == "patch" -%}
            JsonMergePatch patch
    {%- elif operation.body_parameters -%}
            {{ param_helper(operation.body_parameters[0]) }}
    {%- endif -%}

{%- endmacro %}

{%- macro paramsService(operation) -%}
    {%- set params = [] -%}

    {%- for parameter in operation.path_parameters -%}
        {%- set _ = params.append(param_helper(parameter)) -%}
    {%- endfor -%}

    {%- if operation.filter_name -%}
        {%- set _ = params.append(operation.filter_name + " filter") -%}
    {%- endif -%}

    {%- if operation.source.directive.is_pageable -%}
        {%- set _ = params.append("CursorPageable pageable") -%}
    {%- endif -%}

    {%- if operation.request_dto_name -%}
        {%- set _ = params.append(operation.request_dto_name + " request") -%}
    {%- elif operation.body_parameters -%}
        {%- set _ = params.append(param_helper(operation.body_parameters[0])) -%}
    {%- endif -%}

    {{ params | join(", ") }}
{%- endmacro %}

{%- macro paramsCallService(operation) -%}
    {%- set params = [] -%}

    {%- for parameter in operation.path_parameters -%}
        {%- set _ = params.append(parameter.name) -%}
    {%- endfor -%}

    {%- if operation.filter_name -%}
        {%- set _ = params.append("filter") -%}
    {%- endif -%}

    {%- if operation.source.directive.is_pageable -%}
        {%- set _ = params.append("pageable") -%}
    {%- endif -%}

    {%- if operation.request_dto_name -%}
        {%- set _ = params.append("request") -%}
    {%- elif operation.body_parameters and operation.method == "patch" -%}
        {%- set _ = params.append("request") -%}
    {%- elif operation.body_parameters -%}
        {%- set _ = params.append(operation.body_parameters[0].name) -%}
    {%- endif -%}

    {{ params | join(", ") }}
{%- endmacro %}

{%- macro paramsCallServiceGetter(operation) -%}
    {%- set params = [] -%}

    {%- for parameter in operation.path_parameters -%}
        {%- set _ = params.append(parameter.name) -%}
    {%- endfor -%}

    {%- if operation.source.directive.is_pageable -%}
        {%- set _ = params.append("pageable") -%}
    {%- endif -%}

    {{ params | join(", ") }}
{%- endmacro %}

{%- macro paramsCallServiceMocked(operation) -%}
    {%- set params = [] -%}

    {%- for parameter in operation.path_parameters -%}
        {%- set _ = params.append("any()") -%}
    {%- endfor -%}

    {%- if operation.filter_name -%}
        {%- set _ = params.append("any()") -%}
    {%- endif -%}

    {%- if operation.source.directive.is_pageable -%}
        {%- set _ = params.append("any()") -%}
    {%- endif -%}

    {%- if operation.request_dto_name or operation.body_parameters -%}
        {%- set _ = params.append("any()") -%}
    {%- endif -%}

    {{ params | join(", ") }}
{%- endmacro %}

{%- macro param_helper(parameter, validate_items=false) -%}

    {%- if parameter.source.is_array -%}
        List<{{ "@Valid " if validate_items and parameter.is_model else "" }}{{parameter.type}}> {{parameter.name}}
    {%- else -%}
        {{parameter.type}} {{parameter.name}}
    {%- endif %}

{%- endmacro %}
